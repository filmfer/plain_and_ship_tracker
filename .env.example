# ---------------------------------------------------------------------------
# Plain Boat Radar - example environment configuration.
# Copy to `.env` and adjust. If `.env` is absent the app still starts in demo.
# ---------------------------------------------------------------------------

# Application mode: demo | local | production
# Defaults to "demo" when unset (fully offline, deterministic mock data).
APP_MODE=demo

# Backend HTTP server
API_HOST=0.0.0.0
API_PORT=8000

# Comma-separated list of allowed CORS origins (frontend dev server)
CORS_ORIGINS=http://localhost:5173

# Deterministic mock/simulation settings (used from later phases)
MOCK_SEED=42
MOCK_TIME_MULTIPLIER=1
# Real seconds between simulation ticks (loop pacing).
MOCK_TICK_INTERVAL=1

# Deterministic mock history (trails): bounded sample of past positions.
HISTORY_SAMPLE_COUNT=20
HISTORY_SAMPLE_INTERVAL_S=60
HISTORY_MAX_POINTS=200

# --- Redis current-state cache ----------------------------------------------
# The latest entity/position state is mirrored into Redis when reachable.
# Graceful fallback: if Redis is down (or this is an offline demo) the app
# continues with an in-memory cache and logs a clear warning.
REDIS_URL=redis://localhost:6379/0
# Set to false to disable Redis entirely (pure in-memory current state).
STATE_CACHE_ENABLED=true
# Fail-fast connection timeout (seconds) so startup never blocks on Redis.
REDIS_TIMEOUT_S=1
# Cached state expires after this many seconds (no stale state after shutdown).
REDIS_TTL_S=3600

# --- Historical storage (PostgreSQL/PostGIS) --------------------------------
# Historical positions are persisted here once configured.
# Leave empty in demo mode: no database is required and the app starts without
# PostgreSQL (in-memory history only, graceful fallback with a warning).
# Apply schema migrations first:  cd backend && python -m app.migrate up
# DATABASE_URL=postgresql://postgres@localhost:5432/plain_boat_radar
# Fail-fast connect timeout (seconds) so startup never blocks on the DB.
DB_CONNECT_TIMEOUT_S=2
# Meaningful-change filter for historical writes (app.history_write):
# a position is stored only when it differs materially from that entity's last
# stored position (distance / speed / heading) AND at least the minimum time
# has passed. Identical positions are never stored twice.
MIN_POSITION_CHANGE_METERS=50
MIN_TIME_BETWEEN_HISTORY_WRITES=60
# Same units as Position.speed (mock: knots) / degrees (circular heading delta).
MIN_SPEED_CHANGE=5
MIN_HEADING_CHANGE=10

# --- Historical API (GET /api/history/{entity_id}) --------------------------
# Configurable window per request via ?since=...&until=... (ISO-8601; naive
# values are read as UTC). Size protection: default page size, hard cap (also
# the database fetch window), and even downsampling above the requested limit.
HISTORY_API_DEFAULT_LIMIT=500
HISTORY_API_MAX_POINTS=2000

# --- External providers (only used in production mode, never in demo) -------
# Leave empty for demo/local. Never commit real credentials (rule #32).
# OpenSky uses OAuth2 client credentials only (basic auth was removed):
# create an API client at https://opensky-network.org/my-opensky/account.
# Explicit enable: requires APP_MODE=production AND credentials; demo/local
# never call OpenSky regardless of this flag.
OPENSKY_ENABLED=false
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# API root and OAuth2 token endpoint (documented defaults).
OPENSKY_BASE_URL=https://opensky-network.org/api
OPENSKY_TOKEN_URL=https://auth.opensky-network.org/auth/realms/opensky-network/protocol/openid-connect/token
# Client-side throttle; 0 = documented floors (5s authenticated / 10s anonymous).
OPENSKY_MIN_REQUEST_INTERVAL_S=0
OPENSKY_CACHE_TTL_S=5
OPENSKY_TIMEOUT_S=10
# Transient-failure retries with exponential backoff (429 uses cooldown instead).
OPENSKY_MAX_RETRIES=2
OPENSKY_BACKOFF_BASE_S=1
# Optional WGS84 bbox "lamin,lamax,lomin,lomax"; empty = global (4 credits/req).
OPENSKY_BBOX=

# --- AISHub AIS ships (APP_MODE=production only; never used in demo) ---------
# Contributor-based access (Terms of Use: aishub.net/join-us): a username is
# issued to members who stream their own raw AIS feed. Synthesized or scraped
# feeds are prohibited - this app only consumes, it never contributes data.
# Free for approved contributors; leave disabled otherwise (ships stay mock).
AISHUB_ENABLED=false
AISHUB_USERNAME=
AISHUB_BASE_URL=https://data.aishub.net/ws.php
# Documented rule: never poll more than once per minute (floor, can only rise).
AISHUB_MIN_REQUEST_INTERVAL_S=60
AISHUB_CACHE_TTL_S=60
AISHUB_TIMEOUT_S=10
AISHUB_MAX_RETRIES=2
AISHUB_BACKOFF_BASE_S=1
# Optional WGS84 bbox "lamin,lamax,lomin,lomax"; empty = worldwide.
AISHUB_BBOX=

# --- Local AIS receiver (APP_MODE=local opt-in; never used in demo) -----------
# Future local receiver/decoder (e.g. RTL-SDR + aisdecoder NMEA feed).
# No hardware required: without a receiver the provider serves empty snapshots.
# Ships stay on the deterministic mock unless BOTH hold:
# APP_MODE=local AND LOCAL_AIS_ENABLED=true.
LOCAL_AIS_ENABLED=false
LOCAL_AIS_CACHE_TTL_S=5

# --- Anomaly engine (provider-independent; data-quality states only) ---------
# POSITION_STALE: fresh reports arrive but coordinates do not move materially
# (haversine distance below MIN_POSITION_CHANGE_METERS) for longer than this.
# Default 15 minutes (rule #24); WATCH state, 0-100 score ramps past the limit.
ANOMALY_STALE_MINUTES=15
# Legacy alias in seconds (deprecated, still honoured; minutes win if both set).
# ANOMALY_STALE_AFTER_S=900

# --- Tracking-data freshness indicator (LIVE/RECENT/STALE/LOST/UNKNOWN) -----
# Data age (application-clock now minus latest position timestamp) classified
# against these ascending thresholds (seconds). These describe tracking-data
# freshness only, never vessel/aircraft safety.
DATA_STATE_LIVE_S=10
DATA_STATE_RECENT_S=60
DATA_STATE_STALE_S=900
